# WorkForce AI Pro backend configuration.
# Copy to backend/.env and fill in the blanks. Never commit backend/.env.
# The app refuses to start if a required value is missing or unsafe.

APP_NAME=WorkForce AI Pro
# development | test | staging | production. Staging and production refuse to start with wildcard CORS_ORIGINS or
# ALLOWED_HOSTS or with authentication rate limits disabled; production also requires https:// CORS origins.
ENVIRONMENT=development

# --- MySQL (required: DB_USER, DB_PASSWORD) ---
# Use a dedicated application user, not root. Special characters in the password are fine.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=workforce_ai_pro
DB_USER=workforce_app
DB_PASSWORD=

# --- JWT (required: JWT_SECRET_KEY) ---
# At least 32 random characters; placeholders such as "change-me" are rejected.
# Generate one with:
#   .\.venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# One of HS256, HS384, HS512.
JWT_ALGORITHM=HS256
JWT_ISSUER=workforce-ai-pro
# Short-lived access tokens (1-1440 minutes).
ACCESS_TOKEN_EXPIRE_MINUTES=30

# JSON list of allowed frontend origins (staging/production: explicit origins; production: https only),
# e.g. ["https://hr.example.com"].
CORS_ORIGINS=["http://localhost:5173"]
# JSON list of Host header values the API answers to. "*" only in development/test; e.g. ["api.example.com"].
ALLOWED_HOSTS=["*"]
# Interactive docs and OpenAPI schema (/docs, /redoc, /openapi.json). Empty = on in development/test, off otherwise.
# API_DOCS_ENABLED=

# --- Authentication rate limits (in-process: counted per worker process; see docs/DEPLOYMENT_READINESS.md) ---
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
# Failed sign-ins per client address and submitted email within the window, then 429.
AUTH_LOGIN_MAX_FAILURES=5
# All sign-in attempts per client address within the window.
AUTH_LOGIN_MAX_ATTEMPTS_PER_CLIENT=50
# Registrations per client address within the window.
AUTH_REGISTER_MAX_PER_CLIENT=10

# --- Attendance ---
# IANA time zone used for work dates and shift times (timestamps are stored in UTC).
# Set this to your organization's zone, e.g. Asia/Kolkata. Invalid names stop the server from starting.
ORG_TIMEZONE=UTC
# Minutes after a shift's scheduled start before a check-in counts as LATE (0-240).
ATTENDANCE_LATE_GRACE_MINUTES=15
# Overtime threshold (worked minutes per day) for attendance recorded without a shift (1-1440).
ATTENDANCE_DEFAULT_OVERTIME_THRESHOLD_MINUTES=480

# --- Leave ---
# Weekend days excluded from leave-day counts (Python weekday numbers: Monday=0 ... Sunday=6).
LEAVE_WEEKEND_DAYS=[5, 6]
# How many days in the past a leave request may start (0-366).
LEAVE_MAX_BACKDATE_DAYS=30

# --- Payroll ---
# ISO 4217 currency code recorded on payroll records and payslips.
PAYROLL_CURRENCY=INR
# Off by default. When true, deduct base salary / working days per day of APPROVED leave of an unpaid leave type.
PAYROLL_DEDUCT_UNPAID_LEAVE=false
# Off by default. When true, deduct per attendance record explicitly marked ABSENT (missing records never count).
PAYROLL_DEDUCT_RECORDED_ABSENCE=false

# --- AI attrition model ---
# Local directories only (defaults: backend/ml/models and backend/ml/datasets). Both are git-ignored.
# ML_DATASET_DIR stores registered datasets under server-generated names (managed by /api/datasets);
# the API never accepts paths. Do not place or edit files there by hand.
# ML_ARTIFACT_DIR=
# ML_DATASET_DIR=
ML_RANDOM_STATE=42
ML_MIN_TRAINING_ROWS=50
ML_MIN_CLASS_COUNT=10
# A trained model can be activated only if its held-out ROC-AUC reaches this value.
ML_ACTIVATION_MIN_ROC_AUC=0.65
# Risk score (0-100) at or above which a prediction is MEDIUM / HIGH (medium must be below high).
ML_RISK_MEDIUM_THRESHOLD=40
ML_RISK_HIGH_THRESHOLD=70

# --- Dataset registry ---
# Maximum CSV upload size in bytes (1 KiB - 50 MiB). Other limits: 200,000 rows, 50 columns, 200 characters per field.
DATASET_MAX_UPLOAD_BYTES=10485760

# --- Risk monitoring (reads persisted predictions only) ---
# Alert when the latest risk score reaches this value after being below it (or with no comparable baseline).
RISK_ALERT_SCORE_THRESHOLD=70
# A score change of at least this many points between comparable predictions is significant.
RISK_CHANGE_THRESHOLD_POINTS=20
# A latest prediction older than this many days is reported as stale.
RISK_STALE_PREDICTION_DAYS=90
# Maximum employees examined by one monitoring run (1-5000).
RISK_MONITORING_MAX_BATCH=500

# --- Workforce analytics (aggregates; history comes only from captured snapshots) ---
# Observed months required before a forecast is produced (3-36).
WORKFORCE_FORECAST_MIN_MONTHS=6
# Maximum forecast horizon in months (1-36).
WORKFORCE_FORECAST_MAX_HORIZON_MONTHS=12
# Trailing window for the stability indicator, in months (3-36).
WORKFORCE_STABILITY_WINDOW_MONTHS=12
# The latest snapshot must be at most this many days old for a stability score (7-365).
WORKFORCE_SNAPSHOT_MAX_AGE_DAYS=45
# Below this average active headcount no stability score is produced (1-1000).
WORKFORCE_STABILITY_MIN_AVERAGE_HEADCOUNT=10

# --- Recommendation rules (deterministic, rules-v1) ---
# Annualized recorded turnover at or above this suggests a retention review (fraction, e.g. 0.20 = 20%).
RECOMMENDATION_TURNOVER_REVIEW_THRESHOLD=0.20
# A stability indicator below this suggests a workforce trend review (0-100).
RECOMMENDATION_STABILITY_REVIEW_BELOW=60
# Active risk alerts in one department at or above this suggest a team-conditions review.
RECOMMENDATION_ALERT_CLUSTER_MIN=3
# Maximum active alerts examined by one evaluation.
RECOMMENDATION_MAX_ALERTS_PER_EVALUATION=500

# --- Workforce activity feed (read-only, assembled on demand) ---
# Maximum date range of one feed/summary/department request, in days.
ACTIVITY_FEED_MAX_WINDOW_DAYS=31
# Maximum items merged per request (per source); beyond this the response reports truncated=true.
ACTIVITY_FEED_MAX_ITEMS=5000
# Active risk alerts first detected longer ago than this are reported as awaiting review.
ACTIVITY_ALERT_REVIEW_DAYS=14
# A department with current employees but no attendance records in this many days has an attendance data gap.
ACTIVITY_ATTENDANCE_GAP_DAYS=14
# Incremental updates (client polling; not push). Maximum items per /updates response (1-500).
ACTIVITY_UPDATES_MAX_PAGE_SIZE=100
# /updates returns only items recorded at least this many seconds ago, so slow commits are not skipped (0-300).
ACTIVITY_UPDATES_SETTLE_SECONDS=5
# Cursors older than this are rejected with 410 (1-744); also the default look-back without a cursor.
ACTIVITY_UPDATES_CURSOR_MAX_AGE_HOURS=72
# Polling interval suggested to clients, in seconds (5-600).
ACTIVITY_POLL_INTERVAL_SECONDS=20

# --- Reports and exports (CSV / XLSX / PDF) ---
# A report with more rows than the limit is refused (422), never silently cut. PDF limit <= general limit.
REPORT_MAX_ROWS=5000
REPORT_PDF_MAX_ROWS=1000
# Longest date range for the attendance and leave reports, in days.
REPORT_MAX_RANGE_DAYS=366

# --- Audit logs ---
# Longest date window for one audit query or export (default window: the last 30 days).
AUDIT_QUERY_MAX_RANGE_DAYS=366

# --- Risk-alert review deadlines and escalation (evaluated only on explicit request; no scheduler) ---
# Hours from first detection until an alert should be acknowledged, per priority. HIGH <= MEDIUM <= LOW, 1-720.
ALERT_REVIEW_SLA_HOURS_HIGH=24
ALERT_REVIEW_SLA_HOURS_MEDIUM=72
ALERT_REVIEW_SLA_HOURS_LOW=168
# An OPEN alert is APPROACHING its deadline once this percentage of the window has elapsed (1-99).
ALERT_REVIEW_APPROACHING_PERCENT=75
# Maximum alerts examined by one escalation evaluation (1-5000).
ALERT_ESCALATION_MAX_BATCH=500
# Roles notified on escalation (JSON list; only "ADMIN" and "HR" are allowed).
ALERT_ESCALATION_RECIPIENT_ROLES=["ADMIN", "HR"]
# Record and notify the APPROACHING stage too (OVERDUE is always escalated).
ALERT_ESCALATION_NOTIFY_APPROACHING=true
